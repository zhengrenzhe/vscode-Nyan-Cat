{
  "name": "nyan-cat",
  "displayName": "Nyan Cat",
  "description": "Nyan Cat for VS Code",
  "author": {
    "name": "zhengrenzhe",
    "email": "zhengrenzhe.niujie@gmail.com",
    "url": "http://zhengrenzhe.com"
  },
  "homepage": "https://github.com/zhengrenzhe/vscode-Nyan-Cat",
  "bugs": {
    "url": "https://github.com/zhengrenzhe/vscode-Nyan-Cat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhengrenzhe/vscode-Nyan-Cat.git"
  },
  "version": "0.0.8",
  "publisher": "zhengrenzhe",
  "engines": {
    "vscode": "^1.140.0"
  },
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "keywords": [
    "Nyan Cat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.NyanCatSelect",
        "category": "Nyan Cat",
        "title": "Select Nyan Cat"
      },
      {
        "command": "extension.NyanCatRefresh",
        "category": "Nyan Cat",
        "title": "Refresh Status Bar"
      },
      {
        "command": "extension.NyanCatUninstall",
        "category": "Nyan Cat",
        "title": "Ready to Uninstall Nyan Cat"
      },
      {
        "command": "extension.NyanCatReload",
        "category": "Nyan Cat",
        "title": "Reload Nyan Cat"
      }
    ],
    "configuration": {
      "title": "Nyan Cat",
      "properties": {
        "NyanCat.backgroundColor": {
          "description": "Nyan Cat area background color, default is transparent, it accepts any css color string",
          "type": "string",
          "default": "transparent"
        },
        "NyanCat.name": {
          "description": "Which Nyan Cat to show, `random` picks a different one on every window load",
          "type": "string",
          "enum": [
            "GB",
            "bday",
            "breakfast",
            "easter",
            "grumpy",
            "jacksnyan",
            "jazz",
            "mexinyan",
            "mummy",
            "nyan",
            "nyancoin",
            "nyaninja",
            "paddy",
            "pikanyan",
            "sadnyan",
            "slomo",
            "technyancolor",
            "uhmurica",
            "vday",
            "xmas",
            "zombie",
            "random"
          ],
          "default": "bday"
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node -e \"require('fs').copyFileSync('src/nyan-cat.js', 'out/nyan-cat.js')\"",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
